# Mnemosyne configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Neo4j (Docker container, localhost only) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change…word

# --- Ollama (native install on the host) ---
OLLAMA_URL=http://localhost:11434
EXTRACT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_API_KEY=genera…here
# Comma-separated agent IDs allowed to connect (informational; auth is by key)
ALLOWED_AGENTS=hermes-host,hermes-vps,hermes-laptop
